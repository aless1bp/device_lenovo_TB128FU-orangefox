# QCOM FBE Decryption Init Script for OrangeFox Recovery
# TB128FU - Qualcomm SDM680

on init
    # Start keymaster HAL for FBE decryption
    write /proc/sys/kernel/sched_boost 1

on fs
    # Wait for vold to start
    wait_for_prop vold.post_fs_data_done 1

on late-fs
    # Mount userdata with ro initially for inspection
    wait /dev/block/bootdevice/by-name/userdata
    
on property:ro.boot.serialno=*
    # Initialize SELinux contexts
    setprop sys.boot_completed 0

# FBE Metadata Mount
on property:sys.fbe_metadata_done=1
    write /proc/sys/kernel/sched_boost 0
